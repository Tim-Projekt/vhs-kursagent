# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# Google Vertex AI (EU) — primärer LLM-Provider (Gemini + Claude via Model Garden)
# Werte aus dem Service-Account-JSON (IAM → Service Accounts → Key erstellen)
GOOGLE_VERTEX_PROJECT=****
GOOGLE_VERTEX_LOCATION=europe-west1
# GOOGLE_VERTEX_LOCATION_ANTHROPIC=europe-west1
GOOGLE_CLIENT_EMAIL=****
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# Linkup (EU, DSGVO-konform) — Web Search Tool: https://app.linkup.so
LINKUP_API_KEY=****

# Brevo (EU/DSGVO, Paris) — Versand der Passwort-Reset-E-Mails: https://app.brevo.com
# API-Key unter Settings → SMTP & API → API Keys. Ohne gesetzten Key wird der
# Reset-Link stattdessen ins Server-Log geschrieben (nützlich für lokale
# Entwicklung, kein Blocker für den Rest der App).
BREVO_API_KEY=****
# Absenderadresse; muss unter Brevo verifiziert sein (Senders & Domains).
BREVO_FROM_EMAIL=no-reply@fnr.de
BREVO_FROM_NAME="FNR-Assistent"
# Basis-URL für Links in E-Mails (z. B. Passwort-Reset). Fällt sonst auf
# VERCEL_URL bzw. http://localhost:3000 zurück.
NEXT_PUBLIC_APP_URL=https://moor-intelligence.vercel.app
